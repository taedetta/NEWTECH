{
  "name": "express-postgres-starter",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run migrate",
    "migrate": "node migrate.js",
    "setup": "node scripts/fetch-live-cms.js && node scripts/setup-local.js",
    "sync-cms": "node scripts/fetch-live-cms.js",
    "test:qa": "node scripts/seed-test-users.js && node scripts/comprehensive-qa.js",
    "test:flows": "node scripts/seed-test-users.js && node scripts/flow-qa.js",
    "test:hardening": "node scripts/seed-test-users.js && node scripts/test-hardening.js",
    "test:schema": "node scripts/verify-schema.js --fix",
    "test:pipeline": "node scripts/test-complete-pipeline.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.5.0",
    "openai": "^7.56.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1"
  },
  "description": "Flight school management platform — Express.js + PostgreSQL + vanilla JS frontend.",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.60.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "form-data": "4.0.6"
  }
}
